# Deepgram API key for live real-time speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Anthropic Claude API key for live meeting suggestions & summaries
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic Claude Model choice (e.g. claude-3-5-haiku-20241022 or claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Google Gemini API key for low-latency live answers (or paste it in the app gear menu)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model id. The app reads this from .env (friendly names like flash, lite, and pro also work).
# Examples: gemini-3.8-flash, gemini-3.5-flash-lite, gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.8-flash

# true hides the overlay from the taskbar. Ctrl+Shift+H shows it again.
HIDE_FROM_TASKBAR=false

# Optional path to a .txt or .md resume. If empty, the app reads resume.txt or resume.md in this folder.
RESUME_PATH=

# spoken (natural, default) or brief
RESPONSE_STYLE=spoken
