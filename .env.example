# Deepgram API key for live real-time speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenRouter API Key for all AI generation (suggestions, questions, summaries, live answers)
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model choice (e.g. deepseek/deepseek-v4.1-flash, anthropic/claude-3.5-haiku, openai/gpt-4o-mini)
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Optional Anthropic Claude API key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# true hides the overlay from the taskbar. Ctrl+Shift+H shows it again.
HIDE_FROM_TASKBAR=false

# Optional path to a .txt or .md resume. If empty, the app reads resume.txt or resume.md in this folder.
RESUME_PATH=

# spoken (natural, default) or brief
RESPONSE_STYLE=spoken
